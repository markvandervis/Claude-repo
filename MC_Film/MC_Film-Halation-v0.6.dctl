    0.3154019f, -0.87357959f, 0.97289891f, -0.56119116f, -0.14528911f, 0.7754545f, -0.99830292f, 0.6967805f,
    -0.0292656f, -0.65362142f, 0.99318579f, -0.81106716f, 0.20292557f, 0.51180515f, -0.95770395f, 0.90055703f,
    -0.3703815f, -0.35434145f, 0.89294221f, -0.96251415f, 0.52651374f, 0.18604446f, -0.80088052f, 0.99504429f,
    -0.66654886f, -0.01205952f, 0.68433349f, -0.99715291f, 0.78620556f, -0.16229411f, -0.54686431f, 0.96877555f,
    -0.88182558f, 0.33168592f, 0.39267583f, -0.91077979f, 0.95048552f, -0.49093709f, -0.22648206f, 0.82493873f,
    -0.99008623f, 0.63517882f, 0.053364043f, -0.71387679f, 0.99941701f, -0.76000121f, 0.12138547f, 0.58098948f
};



// ----------------------------------------------------------------------------
//  ENCODINGS
// ----------------------------------------------------------------------------

__DEVICE__ float MchDiDecode(float y)
{
    if (y > 0.02740668f) return _exp2f(_fminf(y, 5.0f) / 0.07329248f - 7.0f) - 0.0075f;
    return y / 10.44426855f;
}

__DEVICE__ float MchDiEncode(float x)
{
    if (x > 0.00262409f) return (_log2f(x + 0.0075f) + 7.0f) * 0.07329248f;
    return x * 10.44426855f;
}

__DEVICE__ float MchCctDecode(float y)
{
    if (y > 0.155251141552511f) return _exp2f(_fminf(y, 4.0f) * 17.52f - 9.72f);
    return (y - 0.0729055341958355f) / 10.5402377416545f;
}

__DEVICE__ float MchCctEncode(float x)
{
    if (x <= 0.0078125f) return 10.5402377416545f * x + 0.0729055341958355f;
    return (_log2f(x) + 9.72f) / 17.52f;
}

__DEVICE__ float MchDecode(float v, int enc)
{
    if (enc == HE_DWG) return MchDiDecode(v);
    if (enc == HE_ACESCCT) return MchCctDecode(v);
    return v;
}

__DEVICE__ float MchEncode(float v, int enc)
{
    if (enc == HE_DWG) return MchDiEncode(v);
    if (enc == HE_ACESCCT) return MchCctEncode(v);
    return v;
}

__DEVICE__ unsigned int MchHash(unsigned int x)
{
    x ^= x >> 16; x *= 0x7feb352dU;
    x ^= x >> 15; x *= 0x846ca68bU;
    x ^= x >> 16;
    return x;
}


// ----------------------------------------------------------------------------
//  OPERATOR  (plain arguments)
// ----------------------------------------------------------------------------

// Soft highlight threshold, in linear light: 0 below `thr`, then rising with
// a smooth (C1) knee into a straight line of slope 1.  thr = 0 lets all light
// glow; negative values (out-of-gamut channels) never glow.
__DEVICE__ float MchThreshold(float v, float thr)
{
    if (thr <= 0.0f) return _fmaxf(v, 0.0f);
    float k = thr;                         // knee width
    float x = v - thr;
    if (x <= 0.0f) return 0.0f;
    if (x >= k) return x - 0.5f * k;
    return x * x / (2.0f * k);
}

// Halation (red layer, a little green) and bloom (all layers) added to the
// linear pixel, given the blurred thresholded channels (bloom kernel) and the
// blurred red channel (wider halation kernel).  Only the light arriving from
// brighter neighbours is added, so nothing ever goes down.
__DEVICE__ float3 MchHalate(float3 lin, float3 blurred, float halRed, float amount, float colour, float bloom, float thr)
{
    float tr = MchThreshold(lin.x, thr);
    float dh = _fmaxf(halRed - tr, 0.0f);
    float dr = _fmaxf(blurred.x - tr, 0.0f);
    float dg = _fmaxf(blurred.y - MchThreshold(lin.y, thr), 0.0f);
    float db = _fmaxf(blurred.z - MchThreshold(lin.z, thr), 0.0f);
    return make_float3(lin.x + amount * dh + bloom * dr,
                       lin.y + amount * colour * dh + bloom * dg,
                       lin.z + bloom * db);
}

__DEVICE__ int MchClampI(int v, int hi)
{
    return v < 0 ? 0 : (v > hi ? hi : v);
}


// ----------------------------------------------------------------------------
//  ENTRY POINT  (texture reads: Resolve specific)
// ----------------------------------------------------------------------------

// NOTE: Resolve parses this declaration with a line-based matcher.  It must
// stay on ONE line, in exactly this form, or Resolve reports "wrong argument".
__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    float3 c = make_float3(_tex2D(p_TexR, p_X, p_Y), _tex2D(p_TexG, p_X, p_Y), _tex2D(p_TexB, p_X, p_Y));
    if (uiBypass || (uiHalAmount <= 0.0f && uiBloom <= 0.0f)) return c;

    float thr = (uiHalThreshold > 0.0f) ? MCH_MIDGRAY * _exp2f(uiHalThreshold) : 0.0f;
    float gaugeUm = MCH_GAUGE_WIDTH_UM[uiGauge];
    float amount = uiHalAmount, bloom = uiBloom, colour = uiHalColour, scalePx, strength = 1.0f;
    if (uiSizeMode == HS_MATCHED)
    {
        // g = 0 on Super 35, 1 on 8mm (log of the enlargement), < 0 on 65mm
        float g = _log2f(MCH_REF_WIDTH_UM / gaugeUm) / _log2f(MCH_REF_WIDTH_UM / MCH_SMALL_WIDTH_UM);
        scalePx = MCH_HALO_UM * MCH_MATCH_SIZE * uiHalSize / (MCH_REF_WIDTH_UM / (float)p_Width) *
                  _powf(MCH_REF_WIDTH_UM / gaugeUm, MCH_MATCH_GROWTH);
        strength = _powf(MCH_REF_WIDTH_UM / gaugeUm, MCH_MATCH_STRENGTH);
        amount *= strength;
        bloom *= strength;
        colour = _fmaxf(colour - MCH_MATCH_COLOUR * g, 0.0f);
    }
    else scalePx = MCH_HALO_UM * uiHalSize / (gaugeUm / (float)p_Width);

    int stride = (uiQuality == HQ_ULTRA) ? 1 : ((uiQuality == HQ_BEST) ? 2 : ((uiQuality == HQ_GOOD) ? 4 : 8));
    int nTaps = MCH_TAPS_MAX / stride;
    // Each tap averages three pixels along the tangent, spread over the gap to
    // the neighbouring taps (about 2 pi r / sqrt(n) on a golden-angle spiral),
    // so a small bright source is caught by the taps around it instead of by
    // one or none of them.
    float spread = 6.28318531f / (3.0f * _sqrtf((float)nTaps));
    unsigned int h = MchHash((unsigned int)p_X * 0x8da6b343U ^ (unsigned int)p_Y * 0xd8163841U);
    float rot = (float)(h >> 8) * (6.28318531f / 16777216.0f);
    float cr = _cosf(rot), sr = _sinf(rot);
    int bloomOn = bloom > 0.0f, halOn = amount > 0.0f;

    float sr_ = 0.0f, sg = 0.0f, sb = 0.0f, sh = 0.0f;
    int n = 0;
    for (int i = (int)(h & 7U) % stride; i < MCH_TAPS_MAX; i += stride)
    {
        float r  = MCH_TAP_RADIUS[i] * scalePx;
        float ox = MCH_TAP_COS[i] * cr - MCH_TAP_SIN[i] * sr;
        float oy = MCH_TAP_SIN[i] * cr + MCH_TAP_COS[i] * sr;
        float d  = spread * r;
        for (int k = -1; k <= 1; ++k)
        {
            if (bloomOn)
            {
                int x = MchClampI(p_X + (int)_floor(ox * r - oy * d * (float)k + 0.5f), p_Width - 1);
                int y = MchClampI(p_Y + (int)_floor(oy * r + ox * d * (float)k + 0.5f), p_Height - 1);
                sr_ += MchThreshold(MchDecode(_tex2D(p_TexR, x, y), uiInput), thr);
                sg  += MchThreshold(MchDecode(_tex2D(p_TexG, x, y), uiInput), thr);
                sb  += MchThreshold(MchDecode(_tex2D(p_TexB, x, y), uiInput), thr);
            }
            if (halOn)
            {
                float rw = r * MCH_RED_SPREAD, dw = d * MCH_RED_SPREAD;
                int x = MchClampI(p_X + (int)_floor(ox * rw - oy * dw * (float)k + 0.5f), p_Width - 1);
                int y = MchClampI(p_Y + (int)_floor(oy * rw + ox * dw * (float)k + 0.5f), p_Height - 1);
                sh += MchThreshold(MchDecode(_tex2D(p_TexR, x, y), uiInput), thr);
            }
            n += 1;
        }
    }

    float3 lin = make_float3(MchDecode(c.x, uiInput), MchDecode(c.y, uiInput), MchDecode(c.z, uiInput));
    float inv = 1.0f / (float)n;
    float3 blurred = make_float3(sr_ * inv, sg * inv, sb * inv);
    float3 hal = MchHalate(lin, blurred, sh * inv, amount, colour, bloom, thr);
    if (hal.x == lin.x && hal.y == lin.y && hal.z == lin.z) return c;   // nothing scattered: bit exact
    return make_float3(hal.x == lin.x ? c.x : MchEncode(hal.x, uiInput),
                       hal.y == lin.y ? c.y : MchEncode(hal.y, uiInput),
                       hal.z == lin.z ? c.z : MchEncode(hal.z, uiInput));
}

