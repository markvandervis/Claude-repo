// ----------------------------------------------------------------------------
//  CONSTANTS
// ----------------------------------------------------------------------------

#define MCF_NWL             41          // spectral bands, 380-780 nm, 10 nm
#define MCF_CURVE_N         64
#define MCF_NEG_LOGE_MIN    (-3.0f)
#define MCF_NEG_LOGE_MAX    (4.0f)
#define MCF_PRINTER_POINT   0.025f
#define MCF_LOG10_2         0.30102999566f
#define MCF_LOG2_10         3.32192809489f
#define MCF_PUSH_A          0.245f
#define MCF_PUSH_B          (-0.045f)
#define MCF_GAMUT_THRESHOLD 0.8f
#define MCF_GAMUT_LIMIT     1.2f
#define MCF_GAMUT_POWER     1.2f
#define MCF_TINY            1.0e-10f
#define MCF_TEMP_REF_K      6504.0f
#define MCF_TINT_DUV        0.0002f
#define MCF_MIRED_MIN       40.0f
#define MCF_XOVER_PER_UNIT  0.1f
#define MCF_XOVER_WIDTH     0.6f
#define MCF_XOVER_HOLD_MAX  0.45f
#define MCF_TWIST_MAX       30.0f
#define MCF_ROLLOFF_KNEE    0.5f
#define MCF_VIBRANCE_SCALE  0.15f
#define MCF_RICHNESS_LOGE   0.5f
#define MCF_HLDESAT_START   0.3f
#define MCF_HLDESAT_WIDTH   0.9f
#define MCF_BLEACH_AUTH_K   0.5f
#define MCF_BLEACH_AUTH_E   1.0f
#define MCF_BLEACH_GRUNGE_K 0.75f
#define MCF_BLEACH_GRUNGE_E 1.6f
#define MCF_ROLL_OFF        12.0f
#define MCF_OPEN_AMOUNT     0.5f
#define MCF_OPEN_WIDTH      3.0f
#define MCF_FOG_SCALE       0.1f
#define MCF_ANCHOR_DENSITY  0.15f
#define MCF_ANCHOR_RANGE    0.6f
#define MCF_VIVID_SAT       1.15f
#define MCF_VIVID_RICHNESS  0.2f
#define MCF_VIVID_VIBRANCE  0.1f


// ----------------------------------------------------------------------------
//  1. HELPERS AND ENCODINGS
// ----------------------------------------------------------------------------

__DEVICE__ float McfMax3(float3 v) { return _fmaxf(v.x, _fmaxf(v.y, v.z)); }

__DEVICE__ float McfLog10(float x) { return _log2f(_fmaxf(x, MCF_TINY)) * MCF_LOG10_2; }

__DEVICE__ float McfPow10(float x) { return _exp2f(x * MCF_LOG2_10); }

__DEVICE__ float3 McfMul33(float m00, float m01, float m02, float m10, float m11, float m12,
                           float m20, float m21, float m22, float3 v)
{
    return make_float3(m00 * v.x + m01 * v.y + m02 * v.z,
                       m10 * v.x + m11 * v.y + m12 * v.z,
                       m20 * v.x + m21 * v.y + m22 * v.z);
}

// DaVinci Intermediate and ACEScct decodes (published constants).
__DEVICE__ float McfDiDecode(float y)
{
    if (y > 0.02740668f) return _exp2f(_fminf(y, 5.0f) / 0.07329248f - 7.0f) - 0.0075f;
    return y / 10.44426855f;
}

__DEVICE__ float McfAcescctDecode(float y)
{
    if (y > 0.155251141552511f) return _exp2f(_fminf(y, 4.0f) * 17.52f - 9.72f);
    return (y - 0.0729055341958355f) / 10.5402377416545f;
}

// Scene encodings, in the order of the Input Encoding combo.
#define MCF_ENC_DWG     0
#define MCF_ENC_ACESCCT 1
#define MCF_ENC_LINEAR  2
#define MCF_ENC_709     3

// Input -> scene-linear Rec.709.  The primaries matrices are the ones used by
// the MC HSL Editor (rows normalised to sum to 1, so neutrals stay neutral).
__DEVICE__ float3 McfDecodeInput(float3 c, int input)
{
    if (input == MCF_ENC_DWG)
    {
        float3 l = make_float3(McfDiDecode(c.x), McfDiDecode(c.y), McfDiDecode(c.z));
        return McfMul33( 1.89871504f, -0.79180471f, -0.10691033f,
                        -0.16894835f,  1.48839859f, -0.31945024f,
                        -0.12152602f, -0.31546761f,  1.43699363f, l);
    }
    if (input == MCF_ENC_ACESCCT)
    {
        float3 l = make_float3(McfAcescctDecode(c.x), McfAcescctDecode(c.y), McfAcescctDecode(c.z));
        return McfMul33( 1.70505099f, -0.62179212f, -0.08325887f,
                        -0.13025642f,  1.14080474f, -0.01054832f,
                        -0.02400336f, -0.12896898f,  1.15297233f, l);
    }
    if (input == MCF_ENC_709)
        return make_float3(_powf(_fmaxf(c.x, 0.0f), 2.4f), _powf(_fmaxf(c.y, 0.0f), 2.4f),
                           _powf(_fmaxf(c.z, 0.0f), 2.4f));
    return c;
}

// Soft compression of colours outside Rec.709 (a negative channel) towards
// the neutral axis, per channel on the distance d = (max - c) / max.
// Distances below the threshold are untouched, the limit distance lands on
// the gamut boundary, and the curve in between is smooth and increasing.
__DEVICE__ float McfCompressDistance(float d)
{
    const float thr = MCF_GAMUT_THRESHOLD, lim = MCF_GAMUT_LIMIT, p = MCF_GAMUT_POWER;
    if (d <= thr) return d;
    float s = (lim - thr) / _powf(_powf((1.0f - thr) / (lim - thr), -p) - 1.0f, 1.0f / p);
    float x = (d - thr) / s;
    return thr + s * x / _powf(1.0f + _powf(x, p), 1.0f / p);
}

__DEVICE__ float3 McfGamutCompress(float3 c)
{
    float mx = McfMax3(c);
    if (mx <= 0.0f) return make_float3(_fmaxf(c.x, 0.0f), _fmaxf(c.y, 0.0f), _fmaxf(c.z, 0.0f));
    return make_float3(mx - McfCompressDistance((mx - c.x) / mx) * mx,
                       mx - McfCompressDistance((mx - c.y) / mx) * mx,
                       mx - McfCompressDistance((mx - c.z) / mx) * mx);
}

// Scene white balance (Scene Temp / Scene Tint): re-light the scene with a
// chromatic adaptation (CAT02, von Kries) from the 6504 K Planckian white to
// the chosen white.  Temp is a shift in mireds (+ warmer), Tint moves the
// white perpendicular to the Planckian locus in CIE 1960 uv (+ magenta).
// The locus is the Kim et al. (2002) cubic approximation.
__DEVICE__ float2 McfPlanckXY(float t)
{
    t = _clampf(t, 1667.0f, 25000.0f);
    float t2 = t * t, t3 = t2 * t, x, y;
    if (t <= 4000.0f) x = -0.2661239e9f / t3 - 0.2343589e6f / t2 + 0.8776956e3f / t + 0.179910f;
    else              x = -3.0258469e9f / t3 + 2.1070379e6f / t2 + 0.2226347e3f / t + 0.240390f;
    float x2 = x * x, x3 = x2 * x;
    if (t <= 2222.0f)      y = -1.1063814f * x3 - 1.34811020f * x2 + 2.18555832f * x - 0.20219683f;
    else if (t <= 4000.0f) y = -0.9549476f * x3 - 1.37418593f * x2 + 2.09137015f * x - 0.16748867f;
    else                   y =  3.0817580f * x3 - 5.87338670f * x2 + 3.75112997f * x - 0.37001483f;
    return make_float2(x, y);
}

__DEVICE__ float3 McfWhiteLms(float temp, float tint)
{
    float mired = _fmaxf(1.0e6f / MCF_TEMP_REF_K + temp, MCF_MIRED_MIN);
    float t = 1.0e6f / mired;
    float2 a = McfPlanckXY(t), b = McfPlanckXY(t * 1.01f);
    float da = -2.0f * a.x + 12.0f * a.y + 3.0f, db = -2.0f * b.x + 12.0f * b.y + 3.0f;
    float u = 4.0f * a.x / da, v = 6.0f * a.y / da;
    float du = 4.0f * b.x / db - u, dv = 6.0f * b.y / db - v;
    float n = _sqrtf(du * du + dv * dv);
    float nu = -dv / n, nv = du / n;
    if (nv < 0.0f) { nu = -nu; nv = -nv; }          // normal towards green
    u -= tint * MCF_TINT_DUV * nu;
    v -= tint * MCF_TINT_DUV * nv;
    float d = 2.0f * u - 8.0f * v + 4.0f;
    float x = 3.0f * u / d, y = 2.0f * v / d;
    float3 xyz = make_float3(x / y, 1.0f, (1.0f - x - y) / y);
    return McfMul33(0.7328f, 0.4296f, -0.1624f, -0.7036f, 1.6975f, 0.0061f, 0.0030f, 0.0136f, 0.9834f, xyz);
}

__DEVICE__ float3 McfSceneWhiteBalance(float3 rgb, float temp, float tint)
{
    if (temp == 0.0f && tint == 0.0f) return rgb;
    float3 w = McfWhiteLms(temp, tint), r = McfWhiteLms(0.0f, 0.0f);
    float3 xyz = McfMul33(0.4123908f, 0.3575843f, 0.1804808f,
                          0.2126390f, 0.7151687f, 0.0721923f,
                          0.0193308f, 0.1191948f, 0.9505322f, rgb);
    float3 lms = McfMul33(0.7328f, 0.4296f, -0.1624f, -0.7036f, 1.6975f, 0.0061f, 0.0030f, 0.0136f, 0.9834f, xyz);
    lms = make_float3(lms.x * w.x / r.x, lms.y * w.y / r.y, lms.z * w.z / r.z);
    xyz = McfMul33(1.0961238f, -0.2788690f, 0.1827452f,
                   0.4543690f, 0.4735332f, 0.0720978f,
                  -0.0096276f, -0.0056980f, 1.0153256f, lms);
    return McfMul33( 3.2409699f, -1.5373832f, -0.4986108f,
                    -0.9692436f,  1.8759675f,  0.0415551f,
                     0.0556301f, -0.2039770f,  1.0569715f, xyz);
}

__DEVICE__ float McfEncodeChannel(float v, int output)
{
    v = _fmaxf(v, 0.0f);
    if (output == OUT_SRGB) return v <= 0.0031308f ? 12.92f * v : 1.055f * _powf(v, 1.0f / 2.4f) - 0.055f;
    if (output == OUT_P3)   return _powf(v, 1.0f / 2.6f);
    if (output == OUT_709_22) return _powf(v, 1.0f / 2.2f);
    return _powf(v, 1.0f / 2.4f);
}


