DEFINE_UI_PARAMS(uiOpenClose, Open Close, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_TOOLTIP(uiOpenClose, "+ opens the negative up: shadows and highlights flatten, more latitude, 18 % grey stays. - closes it: steeper, harder ends. Added to the Contrast Preset.")
