// MarkCaptures MC Film Halation
// © 2026 Mark van der Vis / MarkCaptures
// www.markcaptures.com

// ============================================================================
//  MC_Film-Halation-v0.5.dctl  -  MC Film Halation
//  ---------------------------------------------------------------------------
//  Halation for DaVinci Resolve Studio: light that passes through the
//  emulsion, scatters in the film base and comes back to re-expose the
//  emulsion from behind.  It mainly reaches the red-sensitive layer (the
//  bottom one), which is why halation is the red-orange glow around bright
//  highlights.
//
//  It acts on the scene exposure, so it goes BEFORE the negative:
//
//    [grade] -> [MC Film Halation] -> [MC Film Core] ...
//
//  A GLOW THAT ONLY ADDS
//  With D(c) = max(blur(T(c)) - T(c), 0), the light that reaches a pixel from
//  brighter neighbours beyond what it already has:
//
//      R' = R + (a + b) * D(R)
//      G' = G + a * colour * D(R) + b * D(G)
//      B' = B + b * D(B)
//
//  a is Halation (base scatter, red layer), b is Bloom (neutral scatter in
//  the emulsion, irradiation), T a soft highlight threshold (default two
//  stops above 18 % grey).  No channel can ever go down, so the centre of a
//  light keeps its colour at any setting; an even area (a sky, a wall) is
//  left as it is, because its own scatter is already part of the stock's
//  measured response; and everything below the threshold is untouched.
//
//  SIZE MODES
//  Physical: the halo has a fixed size on the film, so a small gauge, which
//  is enlarged more, gets a bigger halo on screen.  Matched (default): the
//  glow keeps about the same size on screen across gauges, growing a little
//  and getting slightly stronger and warmer on small gauges - the behaviour
//  of the commercial film plugins, calibrated in docs/PRESETS.md: the glow
//  Halation strength grows with the enlargement to the power 0.6
//  (35mm 1x, 16mm 1.7x, Super 8 2.4x, 8mm 2.7x).
//
//  THE KERNEL
//  Radially an exponential, with its scale set on the film in micrometres and
//  converted to pixels by the gauge (frame width) and the timeline width, so
//  the halo has the same size on the film at any resolution.  It is
//  importance-sampled: the taps sit at the kernel's radial quantiles on a
//  golden-angle spiral, all with equal weight, and the spiral is rotated per
//  pixel so the sampling shows as fine noise instead of rings.
//
//  Version : 0.5
//  Licence : All rights reserved.  © 2026 Mark van der Vis / MarkCaptures.
//            You may use this file for personal and commercial grading work.
//            You may not redistribute, share, sell, sublicense or publish it,
//            in whole or in part.
// ============================================================================


// ----------------------------------------------------------------------------
//  UI
// ----------------------------------------------------------------------------

DEFINE_UI_PARAMS(uiHalAmount, Halation Amount, DCTLUI_SLIDER_FLOAT, 0.25, 0.0, 1.0, 0.01)
DEFINE_UI_TOOLTIP(uiHalAmount, "Fraction of the red layer's light scattered back through the base: the red-orange halo. In Matched size mode smaller gauges get more automatically.")
DEFINE_UI_PARAMS(uiHalSize, Halation Size, DCTLUI_SLIDER_FLOAT, 1.0, 0.1, 4.0, 0.01)
DEFINE_UI_TOOLTIP(uiHalSize, "Halo radius. Matched: 1 is a typical 35mm halo and the size stays about the same on screen for every gauge. Physical: relative to a typical film base, fixed on the film, so smaller gauges get bigger halos.")
DEFINE_UI_PARAMS(uiHalColour, Halation Colour, DCTLUI_SLIDER_FLOAT, 0.6, 0.0, 1.0, 0.01)
DEFINE_UI_TOOLTIP(uiHalColour, "How much of the scattered light also reaches the green layer: 0 is a deep red halo, higher values move it towards orange and yellow.")
DEFINE_UI_PARAMS(uiBloom, Bloom, DCTLUI_SLIDER_FLOAT, 0.25, 0.0, 1.0, 0.01)
DEFINE_UI_TOOLTIP(uiBloom, "Neutral light scatter in the emulsion (irradiation), on all three layers: the near-white part of a highlight glow. Together with Halation it gives a warm-white glow.")
DEFINE_UI_PARAMS(uiHalThreshold, Highlight Threshold, DCTLUI_SLIDER_FLOAT, 2.0, 0.0, 6.0, 0.1)
DEFINE_UI_TOOLTIP(uiHalThreshold, "Stops above 18 % grey from which light starts to glow (with a soft knee). Everything below is left untouched. Lower it for a glow on more of the image, raise it for the brightest highlights only.")

DEFINE_UI_PARAMS(uiBypass, Bypass, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_TOOLTIP(uiBypass, "Return the input unchanged.")

DEFINE_UI_PARAMS(uiInput, Encoding, DCTLUI_COMBO_BOX, 0, {HE_DWG, HE_ACESCCT, HE_LINEAR}, {DaVinci WG Intermediate, ACES AP1 ACEScct, Scene Linear})
DEFINE_UI_TOOLTIP(uiInput, "Encoding of this node's input; the output is in the same encoding.")
DEFINE_UI_PARAMS(uiGauge, Gauge, DCTLUI_COMBO_BOX, 4, {GAUGE_8, GAUGE_S8, GAUGE_16, GAUGE_S16, GAUGE_S35, GAUGE_65}, {8mm, Super 8, 16mm, Super 16, Super 35, 65mm})
DEFINE_UI_TOOLTIP(uiGauge, "Film format. Use the same gauge as on MC Film Grain.")
DEFINE_UI_PARAMS(uiSizeMode, Size Mode, DCTLUI_COMBO_BOX, 0, {HS_MATCHED, HS_PHYSICAL}, {Matched, Physical})
DEFINE_UI_TOOLTIP(uiSizeMode, "Matched: the glow keeps about the same size on screen for every gauge and gets stronger on small gauges (16mm 1.7x, Super 8 2.4x, 8mm 2.7x the 35mm glow). Physical: the halo has a fixed size on the film, so it grows with the enlargement of small gauges, as on a real print.")
DEFINE_UI_PARAMS(uiQuality, Quality, DCTLUI_COMBO_BOX, 2, {HQ_DRAFT, HQ_GOOD, HQ_BEST, HQ_ULTRA}, {Draft 32, Good 64, Best 128, Ultra 256})
DEFINE_UI_TOOLTIP(uiQuality, "Number of samples of the glow (each averages three pixels). More is smoother and slower: Draft for playback, Ultra for the final render. Very small, very bright lights can still show some speckle - see the clean node-tree setup in the manual.")


// ----------------------------------------------------------------------------
//  CONSTANTS
// ----------------------------------------------------------------------------

#define MCH_HALO_UM         80.0f     // exponential scale of the halo on film
#define MCH_MIDGRAY         0.184f
#define MCH_TAPS_MAX        256
#define MCH_MATCH_SIZE      2.0f   // Matched mode: Size 1 = this x the base halo on 35mm
#define MCH_MATCH_GROWTH    0.07f // on-screen growth exponent towards small gauges
#define MCH_MATCH_STRENGTH  0.6f // glow strength ~ (S35 width / gauge width)^this
#define MCH_MATCH_COLOUR    0.15f // colour shift towards red at the smallest gauge
#define MCH_REF_WIDTH_UM    24890.0f // Super 35
#define MCH_SMALL_WIDTH_UM  4800.0f // 8mm

