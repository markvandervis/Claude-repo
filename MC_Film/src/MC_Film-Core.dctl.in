// ============================================================================
//  MC_Film-Core-v@@VERSION@@.dctl  -  MC Film Core (negative + print engine)
//  ---------------------------------------------------------------------------
//  A physically based film negative and print simulation for DaVinci Resolve
//  Studio.  The scene is exposed onto a colour negative stock, developed,
//  printed onto a print stock with printer lights, and the print is projected
//  and viewed.  Every stage works on measured stock data:
//
//    scene linear
//      -> soft gamut compression into Rec.709
//      -> film layer exposure: 3x3 matrix per stock, the exact result of the
//         Mallett & Yuksel 2019 spectral basis lit by the stock's reference
//         light and integrated against the stock's layer sensitivities
//      -> development: per-layer characteristic curve, exposure, push / pull
//      -> the negative's spectral transmittance (41 bands, 380-780 nm) from its
//         dye and base densities
//      -> printing: printer lamp x negative x print-stock layer sensitivities,
//         Kodak printer points (1 point = 0.025 log E)
//      -> print development: per-layer print characteristic curve
//      -> projection: print dyes under the viewing light -> CIE 1931 XYZ
//      -> chromatic adaptation to D65, display encoding.
//
//  This file is GENERATED by tools/build_dctl.py from src/MC_Film-Core.dctl.in
//  and the stock tables.  Edit the template, not this file.
//
//  Version : @@VERSION@@
//  Licence : CODE - all rights reserved.  © 2026 Mark van der Vis /
//            MarkCaptures.  You may use this file for personal and commercial
//            grading work.  You may not redistribute, share, sell, sublicense
//            or publish it, in whole or in part.
//            STOCK DATA TABLES (the section marked below) - derived from the
//            spektrafilm profiles by Andrea Volpato, licensed CC BY-SA 4.0;
//            see the notice at the start of that section.
//
//  ---------------------------------------------------------------------------
//  STRUCTURE  (for the OFX port)
//  ---------------------------------------------------------------------------
//    1. helpers, encodings          - pure scalar maths
//    2. stock data tables           - generated, CC BY-SA 4.0
//    3. film model                  - McfExpose ... McfProject, plain
//                                     arguments, no UI
//    4. transform()                 - UI -> arguments
// ============================================================================


// ----------------------------------------------------------------------------
//  UI   (Resolve lists sliders, then check boxes, then combo boxes)
// ----------------------------------------------------------------------------

DEFINE_UI_PARAMS(uiExposure, Exposure, DCTLUI_SLIDER_FLOAT, 0.0, -4.0, 4.0, 0.05)
DEFINE_UI_TOOLTIP(uiExposure, "Camera exposure onto the negative, in stops. Over-exposed negative film holds highlights and gets denser; under-exposure thins it out.")
DEFINE_UI_PARAMS(uiPushPull, Push Pull, DCTLUI_SLIDER_FLOAT, 0.0, -2.0, 2.5, 0.1)
DEFINE_UI_PARAMS(uiNegContrast, Negative Contrast, DCTLUI_SLIDER_FLOAT, 1.0, 0.5, 1.5, 0.01)
DEFINE_UI_TOOLTIP(uiPushPull, "Development in stops. Push raises negative contrast the way measured push-processed Portra 800 does (x1.20 at +1, x1.31 at +2); pull lowers it. Combine with Exposure for an under-exposed, pushed roll.")
DEFINE_UI_TOOLTIP(uiNegContrast, "Development gamma of the negative, around 18 % grey. 1 is the stock as measured. The stock's own toe and shoulder are kept.")
DEFINE_UI_PARAMS(uiPrintExposure, Print Exposure, DCTLUI_SLIDER_FLOAT, 0.0, -24.0, 24.0, 1.0)
DEFINE_UI_TOOLTIP(uiPrintExposure, "Printer light in printer points on all three channels, as a lab times a print. +1 point = 0.025 log E more light = a denser, darker print; about 12 points make one stop.")
DEFINE_UI_PARAMS(uiPrinterRed, Printer Red, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 1.0)
DEFINE_UI_TOOLTIP(uiPrinterRed, "Red printer light in points. More red light makes more cyan dye: the print goes cooler / less red.")
DEFINE_UI_PARAMS(uiPrinterGreen, Printer Green, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 1.0)
DEFINE_UI_TOOLTIP(uiPrinterGreen, "Green printer light in points. More green light makes more magenta dye: the print goes more magenta / less green.")
DEFINE_UI_PARAMS(uiPrinterBlue, Printer Blue, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 1.0)
DEFINE_UI_TOOLTIP(uiPrinterBlue, "Blue printer light in points. More blue light makes more yellow dye: the print goes warmer / less blue.")
DEFINE_UI_PARAMS(uiPrintContrast, Print Contrast, DCTLUI_SLIDER_FLOAT, 1.0, 0.5, 1.5, 0.01)
DEFINE_UI_TOOLTIP(uiPrintContrast, "Print development gamma, around 18 % grey. 1 is the print stock as measured; its toe and shoulder (black and white) are kept.")

DEFINE_UI_PARAMS(uiGamutCompress, Gamut Compress Input, DCTLUI_CHECK_BOX, 1)
DEFINE_UI_TOOLTIP(uiGamutCompress, "Softly brings colours outside Rec.709 inside before they are exposed onto film, instead of clipping them.")
DEFINE_UI_PARAMS(uiBypass, Bypass, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_TOOLTIP(uiBypass, "Return the input unchanged.")

DEFINE_UI_PARAMS(uiInput, Input Encoding, DCTLUI_COMBO_BOX, 0, {@@INPUT_ENUMS@@}, {@@INPUT_NAMES@@})
DEFINE_UI_TOOLTIP(uiInput, "What this node receives. In a DaVinci Wide Gamut colour managed project choose DaVinci WG Intermediate.")
DEFINE_UI_PARAMS(uiNegative, Negative Stock, DCTLUI_COMBO_BOX, 1, {@@NEG_ENUMS@@}, {@@NEG_NAMES@@})
DEFINE_UI_TOOLTIP(uiNegative, "The camera negative the scene is exposed onto.")
DEFINE_UI_PARAMS(uiPrint, Print Stock, DCTLUI_COMBO_BOX, 0, {@@PRT_ENUMS@@}, {@@PRT_NAMES@@})
DEFINE_UI_TOOLTIP(uiPrint, "The print stock the negative is printed onto: cinema release prints (2383, 2393) or photographic papers.")
DEFINE_UI_PARAMS(uiOutput, Output, DCTLUI_COMBO_BOX, 0, {@@OUT_ENUMS@@}, {@@OUT_NAMES@@})
DEFINE_UI_TOOLTIP(uiOutput, "Display encoding of the projected print. Negative Cineon Log outputs the developed negative as Cineon densities, to feed a print LUT instead.")


// ----------------------------------------------------------------------------
//  CONSTANTS
// ----------------------------------------------------------------------------

#define MCF_NWL             41          // spectral bands, 380-780 nm, 10 nm
#define MCF_CURVE_N         @@CURVE_N@@
#define MCF_NEG_LOGE_MIN    (@@NEG_LOGE_MIN@@f)
#define MCF_NEG_LOGE_MAX    (@@NEG_LOGE_MAX@@f)
#define MCF_PRINTER_POINT   @@PRINTER_POINT@@f
#define MCF_LOG10_2         0.30102999566f
#define MCF_LOG2_10         3.32192809489f
#define MCF_PUSH_A          @@PUSH_A@@f
#define MCF_PUSH_B          (@@PUSH_B@@f)
#define MCF_GAMUT_THRESHOLD @@GAMUT_THRESHOLD@@f
#define MCF_GAMUT_LIMIT     @@GAMUT_LIMIT@@f
#define MCF_GAMUT_POWER     @@GAMUT_POWER@@f
#define MCF_TINY            1.0e-10f


// ----------------------------------------------------------------------------
//  1. HELPERS AND ENCODINGS
// ----------------------------------------------------------------------------

__DEVICE__ float McfMax3(float3 v) { return _fmaxf(v.x, _fmaxf(v.y, v.z)); }

__DEVICE__ float McfLog10(float x) { return _log2f(_fmaxf(x, MCF_TINY)) * MCF_LOG10_2; }

__DEVICE__ float McfPow10(float x) { return _exp2f(x * MCF_LOG2_10); }

__DEVICE__ float3 McfMul33(float m00, float m01, float m02, float m10, float m11, float m12,
                           float m20, float m21, float m22, float3 v)
{
    return make_float3(m00 * v.x + m01 * v.y + m02 * v.z,
                       m10 * v.x + m11 * v.y + m12 * v.z,
                       m20 * v.x + m21 * v.y + m22 * v.z);
}

// DaVinci Intermediate and ACEScct decodes (published constants).
__DEVICE__ float McfDiDecode(float y)
{
    if (y > 0.02740668f) return _exp2f(_fminf(y, 5.0f) / 0.07329248f - 7.0f) - 0.0075f;
    return y / 10.44426855f;
}

__DEVICE__ float McfAcescctDecode(float y)
{
    if (y > 0.155251141552511f) return _exp2f(_fminf(y, 4.0f) * 17.52f - 9.72f);
    return (y - 0.0729055341958355f) / 10.5402377416545f;
}

// Input -> scene-linear Rec.709.  The primaries matrices are the ones used by
// the MC HSL Editor (rows normalised to sum to 1, so neutrals stay neutral).
__DEVICE__ float3 McfDecodeInput(float3 c, int input)
{
    if (input == IN_DWG)
    {
        float3 l = make_float3(McfDiDecode(c.x), McfDiDecode(c.y), McfDiDecode(c.z));
        return McfMul33( 1.89871504f, -0.79180471f, -0.10691033f,
                        -0.16894835f,  1.48839859f, -0.31945024f,
                        -0.12152602f, -0.31546761f,  1.43699363f, l);
    }
    if (input == IN_ACESCCT)
    {
        float3 l = make_float3(McfAcescctDecode(c.x), McfAcescctDecode(c.y), McfAcescctDecode(c.z));
        return McfMul33( 1.70505099f, -0.62179212f, -0.08325887f,
                        -0.13025642f,  1.14080474f, -0.01054832f,
                        -0.02400336f, -0.12896898f,  1.15297233f, l);
    }
    if (input == IN_709)
        return make_float3(_powf(_fmaxf(c.x, 0.0f), 2.4f), _powf(_fmaxf(c.y, 0.0f), 2.4f),
                           _powf(_fmaxf(c.z, 0.0f), 2.4f));
    return c;
}

// Soft compression of colours outside Rec.709 (a negative channel) towards
// the neutral axis, per channel on the distance d = (max - c) / max.
// Distances below the threshold are untouched, the limit distance lands on
// the gamut boundary, and the curve in between is smooth and increasing.
__DEVICE__ float McfCompressDistance(float d)
{
    const float thr = MCF_GAMUT_THRESHOLD, lim = MCF_GAMUT_LIMIT, p = MCF_GAMUT_POWER;
    if (d <= thr) return d;
    float s = (lim - thr) / _powf(_powf((1.0f - thr) / (lim - thr), -p) - 1.0f, 1.0f / p);
    float x = (d - thr) / s;
    return thr + s * x / _powf(1.0f + _powf(x, p), 1.0f / p);
}

__DEVICE__ float3 McfGamutCompress(float3 c)
{
    float mx = McfMax3(c);
    if (mx <= 0.0f) return make_float3(_fmaxf(c.x, 0.0f), _fmaxf(c.y, 0.0f), _fmaxf(c.z, 0.0f));
    return make_float3(mx - McfCompressDistance((mx - c.x) / mx) * mx,
                       mx - McfCompressDistance((mx - c.y) / mx) * mx,
                       mx - McfCompressDistance((mx - c.z) / mx) * mx);
}

__DEVICE__ float McfEncodeChannel(float v, int output)
{
    v = _fmaxf(v, 0.0f);
    if (output == OUT_SRGB) return v <= 0.0031308f ? 12.92f * v : 1.055f * _powf(v, 1.0f / 2.4f) - 0.055f;
    if (output == OUT_P3)   return _powf(v, 1.0f / 2.6f);
    return _powf(v, 1.0f / 2.4f);
}


// ----------------------------------------------------------------------------
//  2. STOCK DATA TABLES (generated)
// ----------------------------------------------------------------------------
@@TABLES@@
// ---------------------------------------------------------------------------- end of stock data


// ----------------------------------------------------------------------------
//  3. FILM MODEL
// ----------------------------------------------------------------------------

// Characteristic curve lookup: monotone cubic Hermite interpolation
// (Fritsch-Carlson tangents) on a uniform grid.  C1 continuous and, because
// the tables are non-decreasing, never overshoots: a density can only rise
// with exposure.  `table` is a flat [stock][sample][channel] array.
__DEVICE__ float McfTangent(float a, float b)
{
    return (a * b <= 0.0f) ? 0.0f : 2.0f * a * b / (a + b);
}

__DEVICE__ float McfCurve(__CONSTANTREF__ float* table, int stock, int ch, float x, float lo, float hi)
{
    const int n = MCF_CURVE_N;
    int base = stock * n * 3 + ch;
    float t = (x - lo) / ((hi - lo) / (float)(n - 1));
    if (t <= 0.0f) return table[base];
    if (t >= (float)(n - 1)) return table[base + (n - 1) * 3];
    int i = (int)_floor(t);
    float f = t - (float)i;
    float y0 = table[base + (i > 0 ? i - 1 : 0) * 3];
    float y1 = table[base + i * 3];
    float y2 = table[base + (i + 1) * 3];
    float y3 = table[base + (i + 2 < n ? i + 2 : n - 1) * 3];
    float s0 = y1 - y0, s1 = y2 - y1, s2 = y3 - y2;
    float m1 = (i > 0) ? McfTangent(s0, s1) : s1;
    float m2 = (i + 2 < n) ? McfTangent(s1, s2) : s1;
    float f2 = f * f, f3 = f2 * f;
    return (2.0f * f3 - 3.0f * f2 + 1.0f) * y1 + (f3 - 2.0f * f2 + f) * m1 +
           (-2.0f * f3 + 3.0f * f2) * y2 + (f3 - f2) * m2;
}

// Development gamma for a push (> 0) or pull (< 0) in stops: 1 + a p + b p^2
// for push, fitted to measured push-processed Portra 800, and its reciprocal
// for pull.  C1 at 0 and increasing over the slider range.
__DEVICE__ float McfPushGamma(float push)
{
    float q = _fabs(push);
    float g = 1.0f + MCF_PUSH_A * q + MCF_PUSH_B * q * q;
    return push >= 0.0f ? g : 1.0f / g;
}

// Exposure and development: scene-linear Rec.709 -> developed negative
// densities above base (cyan, magenta, yellow dye amounts).  The development
// gamma acts on log exposure around each layer's 18 % grey exposure, so the
// stock's own toe and shoulder still bound the densities and 18 % grey keeps
// its density - the print stays timed.
__DEVICE__ float McfDevelopLayer(int neg, int ch, float logE, float gamma)
{
    float mid = MCF_NEG_LOGE_MID[neg * 3 + ch];
    return McfCurve(MCF_NEG_CURVES, neg, ch, mid + gamma * (logE - mid), MCF_NEG_LOGE_MIN, MCF_NEG_LOGE_MAX);
}

__DEVICE__ float3 McfDevelopNegative(float3 rgb, int neg, float exposureStops, float gamma)
{
    int m = neg * 9;
    float3 raw = McfMul33(MCF_NEG_MATRIX[m + 0], MCF_NEG_MATRIX[m + 1], MCF_NEG_MATRIX[m + 2],
                          MCF_NEG_MATRIX[m + 3], MCF_NEG_MATRIX[m + 4], MCF_NEG_MATRIX[m + 5],
                          MCF_NEG_MATRIX[m + 6], MCF_NEG_MATRIX[m + 7], MCF_NEG_MATRIX[m + 8], rgb);
    float e = exposureStops * MCF_LOG10_2;
    return make_float3(McfDevelopLayer(neg, 0, McfLog10(raw.x) + e, gamma),
                       McfDevelopLayer(neg, 1, McfLog10(raw.y) + e, gamma),
                       McfDevelopLayer(neg, 2, McfLog10(raw.z) + e, gamma));
}

// Printing: light from the printer lamp through the negative onto the three
// print layers, summed over 41 bands.  MCF_PRT_LAMPSENS is lamp x print
// sensitivity, pre-multiplied.  Returns log10 exposure per print layer.
__DEVICE__ float3 McfPrintExposure(float3 d, int neg, int prt)
{
    float hr = 0.0f, hg = 0.0f, hb = 0.0f;
    int nb = neg * MCF_NWL, nd = neg * MCF_NWL * 3, ps = prt * MCF_NWL * 3;
    for (int l = 0; l < MCF_NWL; ++l)
    {
        float dens = MCF_NEG_BASE[nb + l] + d.x * MCF_NEG_DYES[nd + l * 3 + 0]
                                         + d.y * MCF_NEG_DYES[nd + l * 3 + 1]
                                         + d.z * MCF_NEG_DYES[nd + l * 3 + 2];
        float t = McfPow10(-dens);
        hr += t * MCF_PRT_LAMPSENS[ps + l * 3 + 0];
        hg += t * MCF_PRT_LAMPSENS[ps + l * 3 + 1];
        hb += t * MCF_PRT_LAMPSENS[ps + l * 3 + 2];
    }
    return make_float3(McfLog10(hr), McfLog10(hg), McfLog10(hb));
}

// Print development: log exposure -> print dye densities.  Contrast acts on
// log exposure around the balanced 18 % grey exposure `pivot`.
__DEVICE__ float3 McfDevelopPrint(float3 logH, float3 pivot, int prt, float contrast)
{
    float lo = MCF_PRT_LOGE[prt * 2], hi = MCF_PRT_LOGE[prt * 2 + 1];
    return make_float3(McfCurve(MCF_PRT_CURVES, prt, 0, pivot.x + contrast * (logH.x - pivot.x), lo, hi),
                       McfCurve(MCF_PRT_CURVES, prt, 1, pivot.y + contrast * (logH.y - pivot.y), lo, hi),
                       McfCurve(MCF_PRT_CURVES, prt, 2, pivot.z + contrast * (logH.z - pivot.z), lo, hi));
}

// Projection: the print under its viewing light, seen by the CIE 1931
// observer.  MCF_PRT_VIEWCMF is light x colour matching functions, scaled so
// that the clear print (base only) has Y = 1.  Returns D65-adapted XYZ.
__DEVICE__ float3 McfProject(float3 p, int prt)
{
    float x = 0.0f, y = 0.0f, z = 0.0f;
    int pb = prt * MCF_NWL, pd = prt * MCF_NWL * 3;
    for (int l = 0; l < MCF_NWL; ++l)
    {
        float dens = MCF_PRT_BASE[pb + l] + p.x * MCF_PRT_DYES[pd + l * 3 + 0]
                                         + p.y * MCF_PRT_DYES[pd + l * 3 + 1]
                                         + p.z * MCF_PRT_DYES[pd + l * 3 + 2];
        float t = McfPow10(-dens);
        x += t * MCF_PRT_VIEWCMF[pd + l * 3 + 0];
        y += t * MCF_PRT_VIEWCMF[pd + l * 3 + 1];
        z += t * MCF_PRT_VIEWCMF[pd + l * 3 + 2];
    }
    int c = prt * 9;
    return McfMul33(MCF_PRT_CAT[c + 0], MCF_PRT_CAT[c + 1], MCF_PRT_CAT[c + 2],
                    MCF_PRT_CAT[c + 3], MCF_PRT_CAT[c + 4], MCF_PRT_CAT[c + 5],
                    MCF_PRT_CAT[c + 6], MCF_PRT_CAT[c + 7], MCF_PRT_CAT[c + 8], make_float3(x, y, z));
}

// D65 XYZ -> display RGB (linear).
__DEVICE__ float3 McfXyzToOutput(float3 xyz, int output)
{
    if (output == OUT_P3)
        return McfMul33( 2.4934969f, -0.9313836f, -0.4027108f,
                        -0.8294890f,  1.7626641f,  0.0236247f,
                         0.0358458f, -0.0761724f,  0.9568845f, xyz);
    if (output == OUT_2020)
        return McfMul33( 1.7166512f, -0.3556708f, -0.2533663f,
                        -0.6666844f,  1.6164812f,  0.0157685f,
                         0.0176399f, -0.0427706f,  0.9421031f, xyz);
    return McfMul33( 3.2409699f, -1.5373832f, -0.4986108f,
                    -0.9692436f,  1.8759675f,  0.0415551f,
                     0.0556301f, -0.2039770f,  1.0569715f, xyz);
}

// The whole film pipeline, plain arguments.  rgb is scene-linear Rec.709.
__DEVICE__ float3 McfFilmPipeline(float3 rgb, int neg, int prt, int output,
                                  float exposureStops, float negGamma,
                                  float3 printerPoints, float printContrast)
{
    float3 d = McfDevelopNegative(rgb, neg, exposureStops, negGamma);

    if (output == OUT_CINEON)        // Cineon: base at code 95, 0.002 density per code value
        return make_float3(95.0f / 1023.0f + d.x / 2.046f,
                           95.0f / 1023.0f + d.y / 2.046f,
                           95.0f / 1023.0f + d.z / 2.046f);

    float3 h = McfPrintExposure(d, neg, prt);
    int b = (neg * MCF_NPRT + prt) * 3;
    h = make_float3(h.x + MCF_BALANCE[b + 0] + MCF_PRINTER_POINT * printerPoints.x,
                    h.y + MCF_BALANCE[b + 1] + MCF_PRINTER_POINT * printerPoints.y,
                    h.z + MCF_BALANCE[b + 2] + MCF_PRINTER_POINT * printerPoints.z);

    float3 pivot = make_float3(MCF_PIVOT[b + 0], MCF_PIVOT[b + 1], MCF_PIVOT[b + 2]);
    float3 lin = McfXyzToOutput(McfProject(McfDevelopPrint(h, pivot, prt, printContrast), prt), output);
    return make_float3(McfEncodeChannel(lin.x, output), McfEncodeChannel(lin.y, output),
                       McfEncodeChannel(lin.z, output));
}


// ----------------------------------------------------------------------------
//  4. ENTRY POINT
// ----------------------------------------------------------------------------

// NOTE: Resolve parses this declaration with a line-based matcher.  It must
// stay on ONE line, in exactly this form, or Resolve reports "wrong argument".
__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float3 rgbIn = make_float3(p_R, p_G, p_B);
    if (uiBypass) return rgbIn;

    float3 lin = McfDecodeInput(rgbIn, uiInput);
    if (uiGamutCompress) lin = McfGamutCompress(lin);
    lin = make_float3(_fmaxf(lin.x, 0.0f), _fmaxf(lin.y, 0.0f), _fmaxf(lin.z, 0.0f));

    float gamma = uiNegContrast * McfPushGamma(uiPushPull);
    float3 points = make_float3(uiPrintExposure + uiPrinterRed, uiPrintExposure + uiPrinterGreen,
                                uiPrintExposure + uiPrinterBlue);

    return McfFilmPipeline(lin, uiNegative, uiPrint, uiOutput,
                           uiExposure, gamma, points, uiPrintContrast);
}

