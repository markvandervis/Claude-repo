DEFINE_UI_TOOLTIP(uiNegative, "The camera negative the scene is exposed onto.")
DEFINE_UI_PARAMS(uiPrint, Print Stock, DCTLUI_COMBO_BOX, 0, {@@PRT_ENUMS@@}, {@@PRT_NAMES@@})
DEFINE_UI_TOOLTIP(uiPrint, "The print stock the negative is printed onto: cinema release prints (2383, 2393) or photographic papers.")
DEFINE_UI_PARAMS(uiBleach, Bleach Bypass, DCTLUI_COMBO_BOX, 0, {BB_OFF, BB_AUTHENTIC, BB_GRUNGE}, {Off, Authentic, Grunge})
DEFINE_UI_TOOLTIP(uiBleach, "Skip-bleach processing: metallic silver stays in the film next to the dyes. Authentic follows the dye density one to one; Grunge keeps more silver and piles it into the dense parts.")
DEFINE_UI_PARAMS(uiBleachStage, Bleach Stage, DCTLUI_COMBO_BOX, 0, {BS_PRINT, BS_NEGATIVE}, {Print, Negative})
DEFINE_UI_TOOLTIP(uiBleachStage, "Where the bleach is skipped. Print: deep, desaturated blacks and a harder print (the classic release-print look). Negative: the silver piles into the negative's highlights, so the print gets harder and its highlights blow out sooner.")
DEFINE_UI_PARAMS(uiWhite, White Point, DCTLUI_COMBO_BOX, 0, {@@WP_ENUMS@@}, {@@WP_NAMES@@})
DEFINE_UI_TOOLTIP(uiWhite, "White the projected print's white is rendered at. D65 matches the monitor; D60 and D55 keep the warmer white of a projected print.")
DEFINE_UI_PARAMS(uiOutput, Output, DCTLUI_COMBO_BOX, 0, {@@OUT_ENUMS@@}, {@@OUT_NAMES@@})
DEFINE_UI_TOOLTIP(uiOutput, "Encoding of the projected print. DaVinci WG Intermediate keeps the print in DWG for further DWG nodes; finish with a CST to Rec.709 Gamma 2.4 with tone mapping and gamut mapping None. Negative Cineon Log outputs the developed negative, for film effects on the negative, a second MC Film Core node or a print LUT.")


// ----------------------------------------------------------------------------
//  CONSTANTS
// ----------------------------------------------------------------------------

#define MCF_NWL             41          // spectral bands, 380-780 nm, 10 nm
#define MCF_CURVE_N         @@CURVE_N@@
#define MCF_NEG_LOGE_MIN    (@@NEG_LOGE_MIN@@f)
#define MCF_NEG_LOGE_MAX    (@@NEG_LOGE_MAX@@f)
#define MCF_PRINTER_POINT   @@PRINTER_POINT@@f
#define MCF_LOG10_2         0.30102999566f
#define MCF_LOG2_10         3.32192809489f
#define MCF_PUSH_A          @@PUSH_A@@f
#define MCF_PUSH_B          (@@PUSH_B@@f)
#define MCF_GAMUT_THRESHOLD @@GAMUT_THRESHOLD@@f
#define MCF_GAMUT_LIMIT     @@GAMUT_LIMIT@@f
#define MCF_GAMUT_POWER     @@GAMUT_POWER@@f
#define MCF_TINY            1.0e-10f
#define MCF_TEMP_REF_K      @@TEMP_REF_K@@f
#define MCF_TINT_DUV        @@TINT_DUV@@f
#define MCF_MIRED_MIN       @@MIRED_MIN@@f
#define MCF_BLEACH_AUTH_K   @@BLEACH_AUTH_K@@f
#define MCF_BLEACH_AUTH_E   @@BLEACH_AUTH_E@@f
#define MCF_BLEACH_GRUNGE_K @@BLEACH_GRUNGE_K@@f
#define MCF_BLEACH_GRUNGE_E @@BLEACH_GRUNGE_E@@f


// ----------------------------------------------------------------------------
//  1. HELPERS AND ENCODINGS
// ----------------------------------------------------------------------------

__DEVICE__ float McfMax3(float3 v) { return _fmaxf(v.x, _fmaxf(v.y, v.z)); }

__DEVICE__ float McfLog10(float x) { return _log2f(_fmaxf(x, MCF_TINY)) * MCF_LOG10_2; }

__DEVICE__ float McfPow10(float x) { return _exp2f(x * MCF_LOG2_10); }

__DEVICE__ float3 McfMul33(float m00, float m01, float m02, float m10, float m11, float m12,
                           float m20, float m21, float m22, float3 v)
{
    return make_float3(m00 * v.x + m01 * v.y + m02 * v.z,
                       m10 * v.x + m11 * v.y + m12 * v.z,
                       m20 * v.x + m21 * v.y + m22 * v.z);
}

// DaVinci Intermediate and ACEScct decodes (published constants).
__DEVICE__ float McfDiDecode(float y)
{
    if (y > 0.02740668f) return _exp2f(_fminf(y, 5.0f) / 0.07329248f - 7.0f) - 0.0075f;
    return y / 10.44426855f;
}

__DEVICE__ float McfAcescctDecode(float y)
{
    if (y > 0.155251141552511f) return _exp2f(_fminf(y, 4.0f) * 17.52f - 9.72f);
    return (y - 0.0729055341958355f) / 10.5402377416545f;
}

// Input -> scene-linear Rec.709.  The primaries matrices are the ones used by
// the MC HSL Editor (rows normalised to sum to 1, so neutrals stay neutral).
__DEVICE__ float3 McfDecodeInput(float3 c, int input)
{
    if (input == IN_DWG)
    {
        float3 l = make_float3(McfDiDecode(c.x), McfDiDecode(c.y), McfDiDecode(c.z));
        return McfMul33( 1.89871504f, -0.79180471f, -0.10691033f,
                        -0.16894835f,  1.48839859f, -0.31945024f,
                        -0.12152602f, -0.31546761f,  1.43699363f, l);
    }
    if (input == IN_ACESCCT)
    {
        float3 l = make_float3(McfAcescctDecode(c.x), McfAcescctDecode(c.y), McfAcescctDecode(c.z));
        return McfMul33( 1.70505099f, -0.62179212f, -0.08325887f,
                        -0.13025642f,  1.14080474f, -0.01054832f,
                        -0.02400336f, -0.12896898f,  1.15297233f, l);
    }
    if (input == IN_709)
        return make_float3(_powf(_fmaxf(c.x, 0.0f), 2.4f), _powf(_fmaxf(c.y, 0.0f), 2.4f),
                           _powf(_fmaxf(c.z, 0.0f), 2.4f));
    return c;
}

// Soft compression of colours outside Rec.709 (a negative channel) towards
// the neutral axis, per channel on the distance d = (max - c) / max.
// Distances below the threshold are untouched, the limit distance lands on
// the gamut boundary, and the curve in between is smooth and increasing.
__DEVICE__ float McfCompressDistance(float d)
{
    const float thr = MCF_GAMUT_THRESHOLD, lim = MCF_GAMUT_LIMIT, p = MCF_GAMUT_POWER;
    if (d <= thr) return d;
    float s = (lim - thr) / _powf(_powf((1.0f - thr) / (lim - thr), -p) - 1.0f, 1.0f / p);
    float x = (d - thr) / s;
    return thr + s * x / _powf(1.0f + _powf(x, p), 1.0f / p);
}

__DEVICE__ float3 McfGamutCompress(float3 c)
{
    float mx = McfMax3(c);
    if (mx <= 0.0f) return make_float3(_fmaxf(c.x, 0.0f), _fmaxf(c.y, 0.0f), _fmaxf(c.z, 0.0f));
    return make_float3(mx - McfCompressDistance((mx - c.x) / mx) * mx,
                       mx - McfCompressDistance((mx - c.y) / mx) * mx,
                       mx - McfCompressDistance((mx - c.z) / mx) * mx);
}

// Scene white balance (Scene Temp / Scene Tint): re-light the scene with a
// chromatic adaptation (CAT02, von Kries) from the 6504 K Planckian white to
// the chosen white.  Temp is a shift in mireds (+ warmer), Tint moves the
// white perpendicular to the Planckian locus in CIE 1960 uv (+ magenta).
// The locus is the Kim et al. (2002) cubic approximation.
__DEVICE__ float2 McfPlanckXY(float t)
{
    t = _clampf(t, 1667.0f, 25000.0f);
    float t2 = t * t, t3 = t2 * t, x, y;
    if (t <= 4000.0f) x = -0.2661239e9f / t3 - 0.2343589e6f / t2 + 0.8776956e3f / t + 0.179910f;
    else              x = -3.0258469e9f / t3 + 2.1070379e6f / t2 + 0.2226347e3f / t + 0.240390f;
    float x2 = x * x, x3 = x2 * x;
    if (t <= 2222.0f)      y = -1.1063814f * x3 - 1.34811020f * x2 + 2.18555832f * x - 0.20219683f;
    else if (t <= 4000.0f) y = -0.9549476f * x3 - 1.37418593f * x2 + 2.09137015f * x - 0.16748867f;
    else                   y =  3.0817580f * x3 - 5.87338670f * x2 + 3.75112997f * x - 0.37001483f;
    return make_float2(x, y);
}

__DEVICE__ float3 McfWhiteLms(float temp, float tint)
{
    float mired = _fmaxf(1.0e6f / MCF_TEMP_REF_K + temp, MCF_MIRED_MIN);
    float t = 1.0e6f / mired;
    float2 a = McfPlanckXY(t), b = McfPlanckXY(t * 1.01f);
    float da = -2.0f * a.x + 12.0f * a.y + 3.0f, db = -2.0f * b.x + 12.0f * b.y + 3.0f;
    float u = 4.0f * a.x / da, v = 6.0f * a.y / da;
    float du = 4.0f * b.x / db - u, dv = 6.0f * b.y / db - v;
    float n = _sqrtf(du * du + dv * dv);
    float nu = -dv / n, nv = du / n;
    if (nv < 0.0f) { nu = -nu; nv = -nv; }          // normal towards green
    u -= tint * MCF_TINT_DUV * nu;
    v -= tint * MCF_TINT_DUV * nv;
    float d = 2.0f * u - 8.0f * v + 4.0f;
    float x = 3.0f * u / d, y = 2.0f * v / d;
    float3 xyz = make_float3(x / y, 1.0f, (1.0f - x - y) / y);
    return McfMul33(0.7328f, 0.4296f, -0.1624f, -0.7036f, 1.6975f, 0.0061f, 0.0030f, 0.0136f, 0.9834f, xyz);
}

__DEVICE__ float3 McfSceneWhiteBalance(float3 rgb, float temp, float tint)
{
    if (temp == 0.0f && tint == 0.0f) return rgb;
    float3 w = McfWhiteLms(temp, tint), r = McfWhiteLms(0.0f, 0.0f);
    float3 xyz = McfMul33(0.4123908f, 0.3575843f, 0.1804808f,
                          0.2126390f, 0.7151687f, 0.0721923f,
                          0.0193308f, 0.1191948f, 0.9505322f, rgb);
    float3 lms = McfMul33(0.7328f, 0.4296f, -0.1624f, -0.7036f, 1.6975f, 0.0061f, 0.0030f, 0.0136f, 0.9834f, xyz);
    lms = make_float3(lms.x * w.x / r.x, lms.y * w.y / r.y, lms.z * w.z / r.z);
    xyz = McfMul33(1.0961238f, -0.2788690f, 0.1827452f,
                   0.4543690f, 0.4735332f, 0.0720978f,
                  -0.0096276f, -0.0056980f, 1.0153256f, lms);
    return McfMul33( 3.2409699f, -1.5373832f, -0.4986108f,
                    -0.9692436f,  1.8759675f,  0.0415551f,
                     0.0556301f, -0.2039770f,  1.0569715f, xyz);
}

__DEVICE__ float McfEncodeChannel(float v, int output)
{
    v = _fmaxf(v, 0.0f);
    if (output == OUT_SRGB) return v <= 0.0031308f ? 12.92f * v : 1.055f * _powf(v, 1.0f / 2.4f) - 0.055f;
    if (output == OUT_P3)   return _powf(v, 1.0f / 2.6f);
    if (output == OUT_709_22) return _powf(v, 1.0f / 2.2f);
    return _powf(v, 1.0f / 2.4f);
}


// ----------------------------------------------------------------------------
//  2. STOCK DATA TABLES (generated)
// ----------------------------------------------------------------------------
@@TABLES@@
// ---------------------------------------------------------------------------- end of stock data


// ----------------------------------------------------------------------------
//  3. FILM MODEL
// ----------------------------------------------------------------------------

// Characteristic curve lookup: monotone cubic Hermite interpolation
// (Fritsch-Carlson tangents) on a uniform grid.  C1 continuous and, because
// the tables are non-decreasing, never overshoots: a density can only rise
// with exposure.  `table` is a flat [stock][sample][channel] array.
__DEVICE__ float McfTangent(float a, float b)
{
    return (a * b <= 0.0f) ? 0.0f : 2.0f * a * b / (a + b);
}

__DEVICE__ float McfCurve(__CONSTANTREF__ float* table, int stock, int ch, float x, float lo, float hi)
{
    const int n = MCF_CURVE_N;
    int base = stock * n * 3 + ch;
    float t = (x - lo) / ((hi - lo) / (float)(n - 1));
    if (t <= 0.0f) return table[base];
    if (t >= (float)(n - 1)) return table[base + (n - 1) * 3];
    int i = (int)_floor(t);
    float f = t - (float)i;
    float y0 = table[base + (i > 0 ? i - 1 : 0) * 3];
    float y1 = table[base + i * 3];
    float y2 = table[base + (i + 1) * 3];
    float y3 = table[base + (i + 2 < n ? i + 2 : n - 1) * 3];
    float s0 = y1 - y0, s1 = y2 - y1, s2 = y3 - y2;
    float m1 = (i > 0) ? McfTangent(s0, s1) : s1;
    float m2 = (i + 2 < n) ? McfTangent(s1, s2) : s1;
    float f2 = f * f, f3 = f2 * f;
    return (2.0f * f3 - 3.0f * f2 + 1.0f) * y1 + (f3 - 2.0f * f2 + f) * m1 +
           (-2.0f * f3 + 3.0f * f2) * y2 + (f3 - f2) * m2;
}

// Development gamma for a push (> 0) or pull (< 0) in stops: 1 + a p + b p^2
// for push, fitted to measured push-processed Portra 800, and its reciprocal
// for pull.  C1 at 0 and increasing over the slider range.
__DEVICE__ float McfPushGamma(float push)
{
    float q = _fabs(push);
    float g = 1.0f + MCF_PUSH_A * q + MCF_PUSH_B * q * q;
    return push >= 0.0f ? g : 1.0f / g;
}

// Exposure and development: scene-linear Rec.709 -> developed negative
// densities above base (cyan, magenta, yellow dye amounts).  The development
// gamma acts on log exposure around each layer's 18 % grey exposure, so the
// stock's own toe and shoulder still bound the densities and 18 % grey keeps
// its density - the print stays timed.
__DEVICE__ float McfDevelopLayer(int neg, int ch, float relLogE, float gamma)
{
    float mid = MCF_NEG_LOGE_MID[neg * 3 + ch];
    return McfCurve(MCF_NEG_CURVES, neg, ch, mid + gamma * relLogE, MCF_NEG_LOGE_MIN, MCF_NEG_LOGE_MAX);
}

// Film saturation scales how far the three layer exposures (each relative to
// its 18 % grey exposure) spread around their mean.  A grey has no spread and
// is left exactly as it was; 0 turns every colour into the grey of the same
// exposure.
__DEVICE__ float3 McfDevelopNegative(float3 rgb, int neg, float exposureStops, float3 gamma, float filmSat)
{
    int m = neg * 9;
    float3 raw = McfMul33(MCF_NEG_MATRIX[m + 0], MCF_NEG_MATRIX[m + 1], MCF_NEG_MATRIX[m + 2],
                          MCF_NEG_MATRIX[m + 3], MCF_NEG_MATRIX[m + 4], MCF_NEG_MATRIX[m + 5],
                          MCF_NEG_MATRIX[m + 6], MCF_NEG_MATRIX[m + 7], MCF_NEG_MATRIX[m + 8], rgb);
    float e = exposureStops * MCF_LOG10_2;
    float ex = McfLog10(raw.x) + e - MCF_NEG_LOGE_MID[neg * 3 + 0];
    float ey = McfLog10(raw.y) + e - MCF_NEG_LOGE_MID[neg * 3 + 1];
    float ez = McfLog10(raw.z) + e - MCF_NEG_LOGE_MID[neg * 3 + 2];
    if (filmSat != 1.0f)
    {
        float mean = (ex + ey + ez) * (1.0f / 3.0f);
        ex = mean + filmSat * (ex - mean);
        ey = mean + filmSat * (ey - mean);
        ez = mean + filmSat * (ez - mean);
    }
    return make_float3(McfDevelopLayer(neg, 0, ex, gamma.x),
                       McfDevelopLayer(neg, 1, ey, gamma.y),
                       McfDevelopLayer(neg, 2, ez, gamma.z));
}

// Bleach bypass: retained metallic silver is a spectrally flat density that
// follows the dye density of the layer stack, silver = k * mean(D)^e.
__DEVICE__ float McfSilver(float3 d, float k, float e)
{
    if (k <= 0.0f) return 0.0f;
    return k * _powf(_fmaxf((d.x + d.y + d.z) * (1.0f / 3.0f), 0.0f), e);
}

// Print re-timing for bleach bypass on the print: the neutral reduction of
// print log exposure that keeps 18 % grey's visual density once silver is
// added.  Less exposure means less dye and so also less silver, so solve
//     k (m - c * dslope * x)^e = c * vslope * x
// with three Newton steps (m = mean dye density of 18 % grey, vslope / dslope
// = visual / mean dye density per unit log exposure there, c = contrast).
__DEVICE__ float McfPrintBleachRetime(float3 dMid, float vslope, float dslope, float k, float e, float contrast)
{
    if (k <= 0.0f) return 0.0f;
    float m = (dMid.x + dMid.y + dMid.z) * (1.0f / 3.0f);
    float a = contrast * dslope, b = contrast * vslope;
    float x = 0.0f;
    for (int i = 0; i < 3; ++i)
    {
        float u  = _fmaxf(m - a * x, 1.0e-6f);
        float f  = k * _powf(u, e) - b * x;
        float df = -k * e * a * _powf(u, e - 1.0f) - b;
        x = x - f / df;
    }
    return x;
}

// Printing: light from the printer lamp through the negative onto the three
// print layers, summed over 41 bands.  MCF_PRT_LAMPSENS is lamp x print
// sensitivity, pre-multiplied.  Returns log10 exposure per print layer.
__DEVICE__ float3 McfPrintExposure(float3 d, float silver, int neg, int prt)
{
    float hr = 0.0f, hg = 0.0f, hb = 0.0f;
    int nb = neg * MCF_NWL, nd = neg * MCF_NWL * 3, ps = prt * MCF_NWL * 3;
    for (int l = 0; l < MCF_NWL; ++l)
    {
        float dens = MCF_NEG_BASE[nb + l] + silver + d.x * MCF_NEG_DYES[nd + l * 3 + 0]
                                         + d.y * MCF_NEG_DYES[nd + l * 3 + 1]
                                         + d.z * MCF_NEG_DYES[nd + l * 3 + 2];
        float t = McfPow10(-dens);
        hr += t * MCF_PRT_LAMPSENS[ps + l * 3 + 0];
        hg += t * MCF_PRT_LAMPSENS[ps + l * 3 + 1];
        hb += t * MCF_PRT_LAMPSENS[ps + l * 3 + 2];
    }
    return make_float3(McfLog10(hr), McfLog10(hg), McfLog10(hb));
}

// Print development: log exposure -> print dye densities.  Contrast acts on
// log exposure around the balanced 18 % grey exposure `pivot`.
__DEVICE__ float3 McfDevelopPrint(float3 logH, float3 pivot, int prt, float contrast)
{
    float lo = MCF_PRT_LOGE[prt * 2], hi = MCF_PRT_LOGE[prt * 2 + 1];
    return make_float3(McfCurve(MCF_PRT_CURVES, prt, 0, pivot.x + contrast * (logH.x - pivot.x), lo, hi),
                       McfCurve(MCF_PRT_CURVES, prt, 1, pivot.y + contrast * (logH.y - pivot.y), lo, hi),
                       McfCurve(MCF_PRT_CURVES, prt, 2, pivot.z + contrast * (logH.z - pivot.z), lo, hi));
}

// Projection: the print under its viewing light, seen by the CIE 1931
// observer.  MCF_PRT_VIEWCMF is light x colour matching functions, scaled so
// that the clear print (base only) has Y = 1.  Returns D65-adapted XYZ.
__DEVICE__ float3 McfProject(float3 p, float silver, int prt, int white)
{
    float x = 0.0f, y = 0.0f, z = 0.0f;
    int pb = prt * MCF_NWL, pd = prt * MCF_NWL * 3;
    for (int l = 0; l < MCF_NWL; ++l)
    {
        float dens = MCF_PRT_BASE[pb + l] + silver + p.x * MCF_PRT_DYES[pd + l * 3 + 0]
                                         + p.y * MCF_PRT_DYES[pd + l * 3 + 1]
                                         + p.z * MCF_PRT_DYES[pd + l * 3 + 2];
        float t = McfPow10(-dens);
        x += t * MCF_PRT_VIEWCMF[pd + l * 3 + 0];
        y += t * MCF_PRT_VIEWCMF[pd + l * 3 + 1];
        z += t * MCF_PRT_VIEWCMF[pd + l * 3 + 2];
    }
    int c = (prt * 3 + white) * 9;
    return McfMul33(MCF_PRT_CAT[c + 0], MCF_PRT_CAT[c + 1], MCF_PRT_CAT[c + 2],
                    MCF_PRT_CAT[c + 3], MCF_PRT_CAT[c + 4], MCF_PRT_CAT[c + 5],
                    MCF_PRT_CAT[c + 6], MCF_PRT_CAT[c + 7], MCF_PRT_CAT[c + 8], make_float3(x, y, z));
}

__DEVICE__ float McfDiEncode(float x)
{
    if (x > 0.00262409f) return (_log2f(x + 0.0075f) + 7.0f) * 0.07329248f;
    return x * 10.44426855f;
}

// D65 XYZ -> display RGB (linear).
__DEVICE__ float3 McfXyzToOutput(float3 xyz, int output)
{
    if (output == OUT_P3)
        return McfMul33( 2.4934969f, -0.9313836f, -0.4027108f,
                        -0.8294890f,  1.7626641f,  0.0236247f,
                         0.0358458f, -0.0761724f,  0.9568845f, xyz);
    if (output == OUT_2020)
        return McfMul33( 1.7166512f, -0.3556708f, -0.2533663f,
                        -0.6666844f,  1.6164812f,  0.0157685f,
                         0.0176399f, -0.0427706f,  0.9421031f, xyz);
    return McfMul33( 3.2409699f, -1.5373832f, -0.4986108f,
                    -0.9692436f,  1.8759675f,  0.0415551f,
                     0.0556301f, -0.2039770f,  1.0569715f, xyz);
}

// Cineon negative encoding: base at code 95 of 1023, 0.002 density per code
// value.  It carries the developed DYE densities only - the interface between
// the negative stage and the print stage, so that effects that live on the
// film (grain per dye layer, halation) can run between two nodes.
// Negative-stage bleach bypass silver is applied by the node that prints.
#define MCF_CINEON_BLACK    (95.0f / 1023.0f)
#define MCF_CINEON_DPC      2.046f

__DEVICE__ float3 McfCineonEncode(float3 d)
{
    return make_float3(MCF_CINEON_BLACK + d.x / MCF_CINEON_DPC, MCF_CINEON_BLACK + d.y / MCF_CINEON_DPC,
                       MCF_CINEON_BLACK + d.z / MCF_CINEON_DPC);
}

__DEVICE__ float3 McfCineonDecode(float3 c)
{
    return make_float3((c.x - MCF_CINEON_BLACK) * MCF_CINEON_DPC, (c.y - MCF_CINEON_BLACK) * MCF_CINEON_DPC,
                       (c.z - MCF_CINEON_BLACK) * MCF_CINEON_DPC);
}

// Display encoding of the projected print (linear display RGB in).
//   OUT_DWG: the display-linear Rec.709 print carried into DaVinci WG /
//   Intermediate without clipping.  A Color Space Transform DWG / DI ->
//   Rec.709 Gamma 2.4 with tone mapping and gamut mapping set to None gives
//   back the Rec709 Gamma 2.4 output exactly, so DWG effects can follow.
__DEVICE__ float3 McfEncodeOutput(float3 lin, int output)
{
    if (output == OUT_DWG)
    {
        float3 w = McfMul33(0.56273797f, 0.32348330f, 0.11377874f,
                            0.07775428f, 0.74978114f, 0.17246458f,
                            0.06466018f, 0.19195861f, 0.74338121f, lin);
        return make_float3(McfDiEncode(w.x), McfDiEncode(w.y), McfDiEncode(w.z));
    }
    return make_float3(McfEncodeChannel(lin.x, output), McfEncodeChannel(lin.y, output),
                       McfEncodeChannel(lin.z, output));
}

// Print stage, plain arguments: developed negative dye densities -> output.
//   silverNegK / silverPrtK  bleach bypass silver at the negative / print
//   silverE                  silver contrast exponent
//   preserveMid              re-time the print so 18 % grey keeps its density
__DEVICE__ float3 McfPrintStage(float3 d, int neg, int prt, int output, int white,
                                float3 printerPoints, float printContrast,
                                float silverNegK, float silverPrtK, float silverE, int preserveMid)
{
    float sNeg = McfSilver(d, silverNegK, silverE);
    float3 h = McfPrintExposure(d, sNeg, neg, prt);
    int b = (neg * MCF_NPRT + prt) * 3;
    h = make_float3(h.x + MCF_BALANCE[b + 0] + MCF_PRINTER_POINT * printerPoints.x,
                    h.y + MCF_BALANCE[b + 1] + MCF_PRINTER_POINT * printerPoints.y,
                    h.z + MCF_BALANCE[b + 2] + MCF_PRINTER_POINT * printerPoints.z);

    if (preserveMid)
    {
        // Flat silver on the negative takes the same log exposure from every
        // print layer: re-time by exactly that amount.
        float3 dMid = make_float3(MCF_NEG_D_MID[neg * 3], MCF_NEG_D_MID[neg * 3 + 1], MCF_NEG_D_MID[neg * 3 + 2]);
        float sn = McfSilver(dMid, silverNegK, silverE);
        // Silver on the print darkens 18 % grey: give the print less exposure.
        int q = neg * MCF_NPRT + prt;
        float3 pMid = make_float3(MCF_PRT_D_MID[b], MCF_PRT_D_MID[b + 1], MCF_PRT_D_MID[b + 2]);
        float sp = McfPrintBleachRetime(pMid, MCF_PRT_VSLOPE_MID[q], MCF_PRT_DSLOPE_MID[q],
                                        silverPrtK, silverE, printContrast);
        h = make_float3(h.x + sn - sp, h.y + sn - sp, h.z + sn - sp);
    }

    float3 pivot = make_float3(MCF_PIVOT[b + 0], MCF_PIVOT[b + 1], MCF_PIVOT[b + 2]);
    float3 p = McfDevelopPrint(h, pivot, prt, printContrast);
    float3 lin = McfXyzToOutput(McfProject(p, McfSilver(p, silverPrtK, silverE), prt, white), output);
    return McfEncodeOutput(lin, output);
}


// ----------------------------------------------------------------------------
//  4. ENTRY POINT
// ----------------------------------------------------------------------------

// NOTE: Resolve parses this declaration with a line-based matcher.  It must
// stay on ONE line, in exactly this form, or Resolve reports "wrong argument".
__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float3 rgbIn = make_float3(p_R, p_G, p_B);
    if (uiBypass) return rgbIn;

    // --- negative stage: scene -> developed dye densities --------------------
    float3 d;
    if (uiInput == IN_CINEON)
        d = McfCineonDecode(rgbIn);
    else
    {
        float3 lin = McfSceneWhiteBalance(McfDecodeInput(rgbIn, uiInput), uiSceneTemp, uiSceneTint);
        if (uiGamutCompress) lin = McfGamutCompress(lin);
        lin = make_float3(_fmaxf(lin.x, 0.0f), _fmaxf(lin.y, 0.0f), _fmaxf(lin.z, 0.0f));
        float g = uiNegContrast * McfPushGamma(uiPushPull);
        d = McfDevelopNegative(lin, uiNegative, uiExposure,
                               make_float3(g * uiLayerRed, g * uiLayerGreen, g * uiLayerBlue), uiFilmSat);
    }
    if (uiOutput == OUT_CINEON) return McfCineonEncode(d);

    // --- print stage ------------------------------------------------------------
    float3 points = make_float3(uiPrintExposure + uiPrinterRed, uiPrintExposure + uiPrinterGreen,
                                uiPrintExposure + uiPrinterBlue);

    float bk = 0.0f, be = 1.0f;
    if (uiBleach == BB_AUTHENTIC) { bk = MCF_BLEACH_AUTH_K;   be = MCF_BLEACH_AUTH_E; }
    if (uiBleach == BB_GRUNGE)    { bk = MCF_BLEACH_GRUNGE_K; be = MCF_BLEACH_GRUNGE_E; }
    bk *= uiBleachStrength;
    be *= uiSilverContrast;

    return McfPrintStage(d, uiNegative, uiPrint, uiOutput, uiWhite, points, uiPrintContrast,
                         uiBleachStage == BS_NEGATIVE ? bk : 0.0f, uiBleachStage == BS_PRINT ? bk : 0.0f,
                         be, uiPreserveMid);
}

