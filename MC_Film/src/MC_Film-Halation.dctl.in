// ============================================================================
//  MC_Film-Halation-v@@VERSION@@.dctl  -  MC Film Halation
//  ---------------------------------------------------------------------------
//  Halation for DaVinci Resolve Studio: light that passes through the
//  emulsion, scatters in the film base and comes back to re-expose the
//  emulsion from behind.  It mainly reaches the red-sensitive layer (the
//  bottom one), which is why halation is the red-orange glow around bright
//  highlights.
//
//  It acts on the scene exposure, so it goes BEFORE the negative:
//
//    [grade] -> [MC Film Halation] -> [MC Film Core] ...
//
//  REDISTRIBUTION, NOT ADDITION
//  On a large even area the light scattered out of a point is replaced by
//  light scattered in from its neighbours, and that balance is already part
//  of the stock's measured response.  So the operator only moves light:
//
//      R' = R + (a + b) * (blur(T(R)) - T(R))
//      G' = G + a * colour * max(blur(T(R)) - T(R), 0) + b * (blur(T(G)) - T(G))
//      B' = B + b * (blur(T(B)) - T(B))
//
//  a is Halation (base scatter, red layer), b is Bloom (neutral scatter in
//  the emulsion, irradiation).  An even field is left exactly as it is; near
//  a bright edge the glow appears and the core gives up a little.  T is an
//  optional soft highlight threshold (0 = physical, every level scatters).
//
//  SIZE MODES
//  Physical: the halo has a fixed size on the film, so a small gauge, which
//  is enlarged more, gets a bigger halo on screen.  Matched (default): the
//  glow keeps about the same size on screen across gauges, growing a little
//  and getting slightly stronger and warmer on small gauges - the behaviour
//  of the commercial film plugins, calibrated in docs/PRESETS.md: the glow
//  strength (Halation and Bloom) grows with the enlargement to the power 0.6
//  (35mm 1x, 16mm 1.7x, Super 8 2.4x, 8mm 2.7x).
//
//  THE KERNEL
//  Radially an exponential, with its scale set on the film in micrometres and
//  converted to pixels by the gauge (frame width) and the timeline width, so
//  the halo has the same size on the film at any resolution.  It is
//  importance-sampled: the taps sit at the kernel's radial quantiles on a
//  golden-angle spiral, all with equal weight, and the spiral is rotated per
//  pixel so the sampling shows as fine noise instead of rings.
//
//  Version : @@VERSION@@
//  Licence : All rights reserved.  © 2026 Mark van der Vis / MarkCaptures.
//            You may use this file for personal and commercial grading work.
//            You may not redistribute, share, sell, sublicense or publish it,
//            in whole or in part.
// ============================================================================


// ----------------------------------------------------------------------------
//  UI
// ----------------------------------------------------------------------------

DEFINE_UI_PARAMS(uiHalAmount, Halation Amount, DCTLUI_SLIDER_FLOAT, 0.25, 0.0, 1.0, 0.01)
DEFINE_UI_TOOLTIP(uiHalAmount, "Fraction of the red layer's light scattered back through the base: the red-orange halo. In Matched size mode smaller gauges get more automatically.")
DEFINE_UI_PARAMS(uiHalSize, Halation Size, DCTLUI_SLIDER_FLOAT, 1.0, 0.1, 4.0, 0.01)
DEFINE_UI_TOOLTIP(uiHalSize, "Halo radius. Matched: 1 is a typical 35mm halo and the size stays about the same on screen for every gauge. Physical: relative to a typical film base, fixed on the film, so smaller gauges get bigger halos.")
DEFINE_UI_PARAMS(uiHalColour, Halation Colour, DCTLUI_SLIDER_FLOAT, 0.6, 0.0, 1.0, 0.01)
DEFINE_UI_TOOLTIP(uiHalColour, "How much of the scattered light also reaches the green layer: 0 is a deep red halo, higher values move it towards orange and yellow.")
DEFINE_UI_PARAMS(uiBloom, Bloom, DCTLUI_SLIDER_FLOAT, 0.25, 0.0, 1.0, 0.01)
DEFINE_UI_TOOLTIP(uiBloom, "Neutral light scatter in the emulsion (irradiation), on all three layers: the near-white part of a highlight glow. Together with Halation it gives a warm-white glow.")
DEFINE_UI_PARAMS(uiHalThreshold, Highlight Threshold, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 6.0, 0.1)
DEFINE_UI_TOOLTIP(uiHalThreshold, "Stops above 18 % grey below which light does not scatter. 0 is physical (everything scatters, mostly visible at bright edges); raise it to keep the glow on the brightest highlights only.")

DEFINE_UI_PARAMS(uiBypass, Bypass, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_TOOLTIP(uiBypass, "Return the input unchanged.")

DEFINE_UI_PARAMS(uiInput, Encoding, DCTLUI_COMBO_BOX, 0, {HE_DWG, HE_ACESCCT, HE_LINEAR}, {DaVinci WG Intermediate, ACES AP1 ACEScct, Scene Linear})
DEFINE_UI_TOOLTIP(uiInput, "Encoding of this node's input; the output is in the same encoding.")
DEFINE_UI_PARAMS(uiGauge, Gauge, DCTLUI_COMBO_BOX, @@GAUGE_DEFAULT@@, {@@GAUGE_ENUMS@@}, {@@GAUGE_NAMES@@})
DEFINE_UI_TOOLTIP(uiGauge, "Film format. Use the same gauge as on MC Film Grain.")
DEFINE_UI_PARAMS(uiSizeMode, Size Mode, DCTLUI_COMBO_BOX, 0, {HS_MATCHED, HS_PHYSICAL}, {Matched, Physical})
DEFINE_UI_TOOLTIP(uiSizeMode, "Matched: the glow keeps about the same size on screen for every gauge and gets stronger on small gauges (16mm 1.7x, Super 8 2.4x, 8mm 2.7x the 35mm glow). Physical: the halo has a fixed size on the film, so it grows with the enlargement of small gauges, as on a real print.")
DEFINE_UI_PARAMS(uiQuality, Quality, DCTLUI_COMBO_BOX, 2, {HQ_DRAFT, HQ_GOOD, HQ_BEST, HQ_ULTRA}, {Draft 32, Good 64, Best 128, Ultra 256})
DEFINE_UI_TOOLTIP(uiQuality, "Number of samples of the glow (each averages three pixels). More is smoother and slower: Draft for playback, Ultra for the final render. Very small, very bright lights can still show some speckle - see the clean node-tree setup in the manual.")


// ----------------------------------------------------------------------------
//  CONSTANTS
// ----------------------------------------------------------------------------

#define MCH_HALO_UM         @@HALO_UM@@f     // exponential scale of the halo on film
#define MCH_MIDGRAY         0.184f
#define MCH_TAPS_MAX        @@HALO_TAPS@@
#define MCH_MATCH_SIZE      @@MATCH_SIZE@@f   // Matched mode: Size 1 = this x the base halo on 35mm
#define MCH_MATCH_GROWTH    @@MATCH_GROWTH@@f // on-screen growth exponent towards small gauges
#define MCH_MATCH_STRENGTH  @@MATCH_STRENGTH@@f // glow strength ~ (S35 width / gauge width)^this
#define MCH_MATCH_COLOUR    @@MATCH_COLOUR@@f // colour shift towards red at the smallest gauge
#define MCH_REF_WIDTH_UM    @@REF_WIDTH_UM@@f // Super 35
#define MCH_SMALL_WIDTH_UM  @@SMALL_WIDTH_UM@@f // 8mm

@@HALO_TABLES@@


// ----------------------------------------------------------------------------
//  ENCODINGS
// ----------------------------------------------------------------------------

__DEVICE__ float MchDiDecode(float y)
{
    if (y > 0.02740668f) return _exp2f(_fminf(y, 5.0f) / 0.07329248f - 7.0f) - 0.0075f;
    return y / 10.44426855f;
}

__DEVICE__ float MchDiEncode(float x)
{
    if (x > 0.00262409f) return (_log2f(x + 0.0075f) + 7.0f) * 0.07329248f;
    return x * 10.44426855f;
}

__DEVICE__ float MchCctDecode(float y)
{
    if (y > 0.155251141552511f) return _exp2f(_fminf(y, 4.0f) * 17.52f - 9.72f);
    return (y - 0.0729055341958355f) / 10.5402377416545f;
}

__DEVICE__ float MchCctEncode(float x)
{
    if (x <= 0.0078125f) return 10.5402377416545f * x + 0.0729055341958355f;
    return (_log2f(x) + 9.72f) / 17.52f;
}

__DEVICE__ float MchDecode(float v, int enc)
{
    if (enc == HE_DWG) return MchDiDecode(v);
    if (enc == HE_ACESCCT) return MchCctDecode(v);
    return v;
}

__DEVICE__ float MchEncode(float v, int enc)
{
    if (enc == HE_DWG) return MchDiEncode(v);
    if (enc == HE_ACESCCT) return MchCctEncode(v);
    return v;
}

__DEVICE__ unsigned int MchHash(unsigned int x)
{
    x ^= x >> 16; x *= 0x7feb352dU;
    x ^= x >> 15; x *= 0x846ca68bU;
    x ^= x >> 16;
    return x;
}


// ----------------------------------------------------------------------------
//  OPERATOR  (plain arguments)
// ----------------------------------------------------------------------------

// Soft highlight threshold, in linear light: 0 below `thr`, then rising with
// a smooth (C1) knee one stop wide into a straight line of slope 1.  thr = 0
// is the identity.
__DEVICE__ float MchThreshold(float v, float thr)
{
    if (thr <= 0.0f) return v;
    float k = thr;                         // knee width
    float x = v - thr;
    if (x <= 0.0f) return 0.0f;
    if (x >= k) return x - 0.5f * k;
    return x * x / (2.0f * k);
}

// Halation (red layer, a little green) and bloom (all layers) applied to the
// linear pixel, given the blurred thresholded channels.  Both only move light:
// an even field, where blur(T) == T, is left exactly as it is.
__DEVICE__ float3 MchHalate(float3 lin, float3 blurred, float amount, float colour, float bloom, float thr)
{
    float dr = blurred.x - MchThreshold(lin.x, thr);
    float dg = blurred.y - MchThreshold(lin.y, thr);
    float db = blurred.z - MchThreshold(lin.z, thr);
    return make_float3(lin.x + (amount + bloom) * dr,
                       lin.y + amount * colour * _fmaxf(dr, 0.0f) + bloom * dg,
                       lin.z + bloom * db);
}

__DEVICE__ int MchClampI(int v, int hi)
{
    return v < 0 ? 0 : (v > hi ? hi : v);
}


// ----------------------------------------------------------------------------
//  ENTRY POINT  (texture reads: Resolve specific)
// ----------------------------------------------------------------------------

// NOTE: Resolve parses this declaration with a line-based matcher.  It must
// stay on ONE line, in exactly this form, or Resolve reports "wrong argument".
__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    float3 c = make_float3(_tex2D(p_TexR, p_X, p_Y), _tex2D(p_TexG, p_X, p_Y), _tex2D(p_TexB, p_X, p_Y));
    if (uiBypass || (uiHalAmount <= 0.0f && uiBloom <= 0.0f)) return c;

    float thr = (uiHalThreshold > 0.0f) ? MCH_MIDGRAY * _exp2f(uiHalThreshold) : 0.0f;
    float gaugeUm = MCH_GAUGE_WIDTH_UM[uiGauge];
    float amount = uiHalAmount, colour = uiHalColour, scalePx, strength = 1.0f;
    if (uiSizeMode == HS_MATCHED)
    {
        // g = 0 on Super 35, 1 on 8mm (log of the enlargement), < 0 on 65mm
        float g = _log2f(MCH_REF_WIDTH_UM / gaugeUm) / _log2f(MCH_REF_WIDTH_UM / MCH_SMALL_WIDTH_UM);
        scalePx = MCH_HALO_UM * MCH_MATCH_SIZE * uiHalSize / (MCH_REF_WIDTH_UM / (float)p_Width) *
                  _powf(MCH_REF_WIDTH_UM / gaugeUm, MCH_MATCH_GROWTH);
        strength = _powf(MCH_REF_WIDTH_UM / gaugeUm, MCH_MATCH_STRENGTH);
        amount *= strength;
        colour = _fmaxf(colour - MCH_MATCH_COLOUR * g, 0.0f);
    }
    else scalePx = MCH_HALO_UM * uiHalSize / (gaugeUm / (float)p_Width);

    int stride = (uiQuality == HQ_ULTRA) ? 1 : ((uiQuality == HQ_BEST) ? 2 : ((uiQuality == HQ_GOOD) ? 4 : 8));
    int nTaps = MCH_TAPS_MAX / stride;
    // Each tap averages three pixels along the tangent, spread over the gap to
    // the neighbouring taps (about 2 pi r / sqrt(n) on a golden-angle spiral),
    // so a small bright source is caught by the taps around it instead of by
    // one or none of them.
    float spread = 6.28318531f / (3.0f * _sqrtf((float)nTaps));
    unsigned int h = MchHash((unsigned int)p_X * 0x8da6b343U ^ (unsigned int)p_Y * 0xd8163841U);
    float rot = (float)(h >> 8) * (6.28318531f / 16777216.0f);
    float cr = _cosf(rot), sr = _sinf(rot);
    int bloomOn = uiBloom > 0.0f;

    float sr_ = 0.0f, sg = 0.0f, sb = 0.0f;
    int n = 0;
    for (int i = (int)(h & 7U) % stride; i < MCH_TAPS_MAX; i += stride)
    {
        float r  = MCH_TAP_RADIUS[i] * scalePx;
        float ox = MCH_TAP_COS[i] * cr - MCH_TAP_SIN[i] * sr;
        float oy = MCH_TAP_SIN[i] * cr + MCH_TAP_COS[i] * sr;
        float d  = spread * r;
        for (int k = -1; k <= 1; ++k)
        {
            int x = MchClampI(p_X + (int)_floor(ox * r - oy * d * (float)k + 0.5f), p_Width - 1);
            int y = MchClampI(p_Y + (int)_floor(oy * r + ox * d * (float)k + 0.5f), p_Height - 1);
            sr_ += MchThreshold(MchDecode(_tex2D(p_TexR, x, y), uiInput), thr);
            if (bloomOn)
            {
                sg += MchThreshold(MchDecode(_tex2D(p_TexG, x, y), uiInput), thr);
                sb += MchThreshold(MchDecode(_tex2D(p_TexB, x, y), uiInput), thr);
            }
            n += 1;
        }
    }

    float3 lin = make_float3(MchDecode(c.x, uiInput), MchDecode(c.y, uiInput), MchDecode(c.z, uiInput));
    float inv = 1.0f / (float)n;
    float3 blurred = make_float3(sr_ * inv,
                                 bloomOn ? sg * inv : MchThreshold(lin.y, thr),
                                 bloomOn ? sb * inv : MchThreshold(lin.z, thr));
    float3 hal = MchHalate(lin, blurred, amount, colour, uiBloom * strength, thr);
    if (hal.x == lin.x && hal.y == lin.y && hal.z == lin.z) return c;   // nothing scattered: bit exact
    return make_float3(hal.x == lin.x ? c.x : MchEncode(hal.x, uiInput),
                       hal.y == lin.y ? c.y : MchEncode(hal.y, uiInput),
                       hal.z == lin.z ? c.z : MchEncode(hal.z, uiInput));
}

